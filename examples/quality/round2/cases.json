[
  {
    "id": "R01_1",
    "family": "action_state",
    "split": "dev",
    "pair_id": "R01",
    "messages": [
      {
        "id": "u1",
        "role": "user",
        "content": "夜间目录同步要调整，但今天先把申请准备好。"
      },
      {
        "id": "a1",
        "role": "assistant",
        "content": "我拟把同步间隔由二十分钟改为十五分钟，涉及东区目录服务。"
      },
      {
        "id": "u2",
        "role": "user",
        "content": "这次只处理东区，西区的计划下周再讨论。"
      },
      {
        "id": "a2",
        "role": "assistant",
        "content": "申请里会列东区范围，旧配置也会保存。"
      },
      {
        "id": "u3",
        "role": "user",
        "content": "备份配置的保存位置和申请记录一起给我。"
      },
      {
        "id": "a3",
        "role": "assistant",
        "content": "备份路径已登记在申请草稿；尚未把路径可用性当作恢复测试结果。"
      },
      {
        "id": "u4",
        "role": "user",
        "content": "等维护窗口批准后再操作，批准前不要修改。"
      },
      {
        "id": "a4",
        "role": "assistant",
        "content": "维护窗口申请已提交，还在等待值班负责人确认。"
      },
      {
        "id": "u5",
        "role": "user",
        "content": "窗口获批的通知我收到了。允许在该窗口内按草稿实施。"
      },
      {
        "id": "a5",
        "role": "assistant",
        "content": "收到，我会把操作、完成状态和复核分开记录。"
      },
      {
        "id": "u6",
        "role": "user",
        "content": "如果窗口内没有做完，也记录实际停在哪一步。"
      },
      {
        "id": "a6",
        "role": "assistant",
        "content": "操作单目前仅列出了拟执行命令；尚无执行日志，我没有确认修改是否发生。"
      },
      {
        "id": "u7",
        "role": "user",
        "content": "把目前记录整理出来，给交班同事看。"
      },
      {
        "id": "a7",
        "role": "assistant",
        "content": "交班说明会写清范围、授权、记录中的状态和仍未复核的部分。"
      },
      {
        "id": "u8",
        "role": "user",
        "content": "没有记录到的效果暂时留空，不必写成功结论。"
      },
      {
        "id": "a8",
        "role": "assistant",
        "content": "本段没有西区操作记录，也没有恢复演练报告。"
      }
    ],
    "expected": {
      "must_find": [
        "允许实施是授权，操作单只有计划，记录不能确认修改发生。",
        "效果、恢复能力和西区状态仍未知。"
      ],
      "must_avoid": [
        "写成已完成东区切换或同步效果已验证。",
        "把用户授权等同用户亲自执行。"
      ]
    },
    "direction_policy": {
      "mode": "required",
      "reason": "指令、授权、操作记录与运行效果交错，存在具体且可迁移的事实状态区分价值；不能把空方向标为不适用逃过遗漏评价。"
    }
  },
