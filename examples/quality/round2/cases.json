  {
    "id": "R02_1",
    "family": "metric_purpose",
    "split": "dev",
    "pair_id": "R02",
    "messages": [
      {
        "id": "u1",
        "role": "user",
        "content": "门店标签识别准备上线试点，我想先核对标准。"
      },
      {
        "id": "a1",
        "role": "assistant",
        "content": "当前有准确率、人工复核比例和告警阈值三份记录。"
      },
      {
        "id": "u2",
        "role": "user",
        "content": "我们承诺的是固定光照的两家门店，不能据此说全场景可用。"
      },
      {
        "id": "a2",
        "role": "assistant",
        "content": "我将试点范围写进版本说明。"
      },
      {
        "id": "u3",
        "role": "user",
        "content": "准确率的计算要包括漏识别，不能只算已返回结果。"
      },
      {
        "id": "a3",
        "role": "assistant",
        "content": "本轮报告说漏识别也计入分母，样本为两家门店各一千张未参与调参的标签。"
      },
      {
        "id": "u4",
        "role": "user",
        "content": "那 97% 这条线最初用来做什么？请照审批记录写。"
      },
      {
        "id": "a4",
        "role": "assistant",
        "content": "审批记录将 97% 定为运行中触发紧急回退的线，没有写它是上线验收门槛。"
      },
      {
        "id": "u5",
        "role": "user",
        "content": "审批记录里没有明确的其他准确率门槛时，不要补一个数。"
      },
      {
        "id": "a5",
        "role": "assistant",
        "content": "本轮准确率报告为 98%，我还没有复查原始计数。"
      },
      {
        "id": "u6",
        "role": "user",
        "content": "另外人工复核比例是多少？"
      },
      {
        "id": "a6",
        "role": "assistant",
        "content": "报告为 7%；审批材料规定不超过 10%。"
      },
      {
        "id": "u7",
        "role": "user",
        "content": "把两个指标分别列出，不要把准确率和人工比例混成同一个比例。"
      },
      {
        "id": "a7",
        "role": "assistant",
        "content": "助手草稿写“两个指标全部满足上线验收标准”，等待核对。"
      },
      {
        "id": "u8",
        "role": "user",
        "content": "需要说明这句话是否有足够依据；结果来源也照实保留。"
      },
      {
        "id": "a8",
        "role": "assistant",
        "content": "目前只有这份报告和审批文字，没有新的现场运行记录。"
      }
    ],
    "expected": {
      "must_find": [
        "98%高于回退线不等于满足未给出的准确率验收门槛。",
        "7%低于10%支持人工复核比例达标，但数据仍来自报告。"
      ],
      "must_avoid": [
        "把回退线直接升级成上线验收线。",
        "因为缺少准确率门槛就否认人工复核比例的明确标准。"
      ]
    },
    "direction_policy": {
      "mode": "required",
      "reason": "指标用途对结论有决定性影响；适合提出区分标准用途与证据来源的具体方向。"
    }
  },
