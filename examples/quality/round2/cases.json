  {
    "id": "R03_1",
    "family": "numeric_scope",
    "split": "dev",
    "pair_id": "R03",
    "messages": [
      {
        "id": "u1",
        "role": "user",
        "content": "预约短信准备接新供应商，本季度剩余预算是六千元。"
      },
      {
        "id": "a1",
        "role": "assistant",
        "content": "旧供应商单条六分，新供应商报价单条四分。"
      },
      {
        "id": "u2",
        "role": "user",
        "content": "预计本季度要发十二万条，先按这个量核算。"
      },
      {
        "id": "a2",
        "role": "assistant",
        "content": "按单条价，新供应商发送费用约四千八百元。"
      },
      {
        "id": "u3",
        "role": "user",
        "content": "报价还有平台服务费，不能遗漏。"
      },
      {
        "id": "a3",
        "role": "assistant",
        "content": "服务费为六百元，每个自然季度收取一次。"
      },
      {
        "id": "u4",
        "role": "user",
        "content": "这笔预算只能用于这个季度，没有另行批复的追加额度。"
      },
      {
        "id": "a4",
        "role": "assistant",
        "content": "已知季度有三个月；报价没有一次性接入费。"
      },
      {
        "id": "u5",
        "role": "user",
        "content": "可靠性上，旧渠道有近期月报，新渠道只有对方提供的试发报告。"
      },
      {
        "id": "a5",
        "role": "assistant",
        "content": "新渠道声称试发成功率较高，但两份报告样本与时间不同，不能直接证明更可靠。"
      },
      {
        "id": "u6",
        "role": "user",
        "content": "我仍希望在预算内降低费用，不以未验证的可靠性提升作承诺。"
      },
      {
        "id": "a6",
        "role": "assistant",
        "content": "助手草稿按四千八百加六百，写“总额五千四百，预算内”。"
      },
      {
        "id": "u7",
        "role": "user",
        "content": "先检查这份费用结论再决定是否签约。"
      },
      {
        "id": "a7",
        "role": "assistant",
        "content": "目前没有合同签署、付款或新渠道发送记录。"
      },
      {
        "id": "u8",
        "role": "user",
        "content": "若报价单位使总额超出预算，只列差额和待决条件，不臆造可获批准的例外。"
      },
      {
        "id": "a8",
        "role": "assistant",
        "content": "其他约束不变；供应商报价还未谈判。"
      }
    ],
    "expected": {
      "must_find": [
        "季度费用4800+600=5400，低于6000剩余额度600。",
        "只支持预计量与报价条件下的预算判断，不支持实际节省已发生或新渠道更可靠。"
      ],
      "must_avoid": [
        "把季度服务费乘三。",
        "把未签约报价当成实际付款。"
      ]
    },
    "direction_policy": {
      "mode": "required",
      "reason": "数值单位和适用时间直接影响预算取舍，需能识别计算与标准用途的缺口。"
    }
  },
