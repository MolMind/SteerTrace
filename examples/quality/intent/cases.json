  {
    "id": "bounded_delivery_gap",
    "family": "bounded_delivery",
    "pair_id": "bounded_delivery",
    "split": "holdout",
    "direction_policy": {
      "mode": "required",
      "reason": "目标相关的可见证据缺口尚未补足，具体检查具有增量价值。"
    },
    "messages": [
      {
        "id": "u1",
        "role": "user",
        "content": "周五演示一个离线个人记事本，只在我自己的电脑用，不上线。"
      },
      {
        "id": "a1",
        "role": "assistant",
        "content": "采用本地文件保存，不接入云端账号。"
      },
      {
        "id": "u2",
        "role": "user",
        "content": "按这个来。"
      },
      {
        "id": "a2",
        "role": "assistant",
        "content": "已实现本地新增、编辑和保存。"
      },
      {
        "id": "u3",
        "role": "user",
        "content": "优先保证演示流程，云同步以后再看。"
      },
      {
        "id": "a3",
        "role": "assistant",
        "content": "已把云同步移出范围，接下来做重新打开文件的检查。"
      },
      {
        "id": "u4",
        "role": "user",
        "content": "我会有中文和多行笔记。"
      },
      {
        "id": "a4",
        "role": "assistant",
        "content": "中文和多行保存后可读；还没有检查关闭程序后重新打开。"
      },
      {
        "id": "u5",
        "role": "user",
        "content": "重开后也要能看到原来的内容。"
      },
      {
        "id": "a5",
        "role": "assistant",
        "content": "已补充重新打开的验收步骤。"
      },
      {
        "id": "u6",
        "role": "user",
        "content": "现在把实现和检查结果分开给我。"
      },
      {
        "id": "a6",
        "role": "assistant",
        "content": "本地保存代码已完成，重开检查尚未执行。"
      },
      {
        "id": "u7",
        "role": "user",
        "content": "未检查的如实写出来，先不扩大范围。"
      },
      {
        "id": "a7",
        "role": "assistant",
        "content": "报告已列出未检查项，没有添加云同步。"
      }
    ],
    "expected": {
      "must_find": [
        "核心持久化要求仍缺重开结果，可给出保存后退出重开比较内容的具体检查。",
        "保留用户控制范围和区分实现与检查的判断。"
      ],
      "must_avoid": [
        "强加上线安全、云同步或多用户架构要求。",
        "把未测试写成已丢笔记。",
        "把单次成功写成用户判断能力提升。"
      ]
    }
  },
