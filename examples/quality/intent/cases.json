  {
    "id": "acceptance_scope_gap",
    "family": "acceptance_scope",
    "pair_id": "acceptance_scope",
    "split": "holdout",
    "direction_policy": {
      "mode": "required",
      "reason": "目标相关的可见证据缺口尚未补足，具体检查具有增量价值。"
    },
    "messages": [
      {
        "id": "u1",
        "role": "user",
        "content": "做一个跨部门报销识别工具，需要处理不同部门的票据。"
      },
      {
        "id": "a1",
        "role": "assistant",
        "content": "先用财务提供的十张票据调试字段提取。"
      },
      {
        "id": "u2",
        "role": "user",
        "content": "好。"
      },
      {
        "id": "a2",
        "role": "assistant",
        "content": "已实现提取代码，这十张票据全部识别正确。"
      },
      {
        "id": "u3",
        "role": "user",
        "content": "这就能给其他部门用了吗？"
      },
      {
        "id": "a3",
        "role": "assistant",
        "content": "我认为已具备跨部门能力，可以准备开放。"
      },
      {
        "id": "u4",
        "role": "user",
        "content": "先别开放，我想知道有没有其他格式。"
      },
      {
        "id": "a4",
        "role": "assistant",
        "content": "目前没有其他部门样本，十张票据都参与过调试。"
      },
      {
        "id": "u5",
        "role": "user",
        "content": "那先冻结代码，补不同部门的新票据。"
      },
      {
        "id": "a5",
        "role": "assistant",
        "content": "代码已冻结，验收页会分别显示部门与票据格式。"
      },
      {
        "id": "u6",
        "role": "user",
        "content": "验收报告不要只给总准确率。"
      },
      {
        "id": "a6",
        "role": "assistant",
        "content": "验收页已实现，但没有拿到新票据，当前结果仍只有那十张调试票据。"
      },
      {
        "id": "u7",
        "role": "user",
        "content": "先按当前证据写报告，不开放。"
      },
      {
        "id": "a7",
        "role": "assistant",
        "content": "报告已注明当前样本范围，未向其他部门开放。"
      }
    ],
    "expected": {
      "must_find": [
        "AI通用能力结论超出调试样本证据；用户随后质疑并纠正，不能把过度泛化归给用户。",
        "验收页实现不等于新样本验收完成；可提出补新部门票据并分组比较，说明证据作用。"
      ],
      "must_avoid": [
        "把AI的泛化断言当作用户提出。",
        "忽略用户纠正，批评其拒绝新样本。",
        "把验收页代码或同意建议当成验收通过。"
      ]
    }
  },
