[
  {
    "id": "proposal_rollback_gap",
    "family": "proposal_rollback",
    "pair_id": "proposal_rollback",
    "split": "dev",
    "direction_policy": {
      "mode": "required",
      "reason": "目标相关的可见证据缺口尚未补足，具体检查具有增量价值。"
    },
    "messages": [
      {
        "id": "u1",
        "role": "user",
        "content": "做一个门店预约系统，先交付单店版本，不能丢失已确认预约。"
      },
      {
        "id": "a1",
        "role": "assistant",
        "content": "建议把预约表迁到新结构，迁移前备份，再切换写入路径。"
      },
      {
        "id": "u2",
        "role": "user",
        "content": "可以，继续。"
      },
      {
        "id": "a2",
        "role": "assistant",
        "content": "迁移脚本已实现，备份文件也会生成；还没有测试恢复和切回旧结构。"
      },
      {
        "id": "u3",
        "role": "user",
        "content": "新版本能同时支持手机预约吗？"
      },
      {
        "id": "a3",
        "role": "assistant",
        "content": "已实现响应式预约页，桌面与手机共用接口。"
      },
      {
        "id": "u4",
        "role": "user",
        "content": "先别增加会员系统，先把预约做完。"
      },
      {
        "id": "a4",
        "role": "assistant",
        "content": "已移除会员入口，测试环境中新增和取消预约的测试通过。"
      },
      {
        "id": "u5",
        "role": "user",
        "content": "取消预约不能影响其他人的记录。"
      },
      {
        "id": "a5",
        "role": "assistant",
        "content": "已补充预约编号隔离检查，相关测试通过。"
      },
      {
        "id": "u6",
        "role": "user",
        "content": "切换前确认迁移后的预约数量一致。"
      },
      {
        "id": "a6",
        "role": "assistant",
        "content": "测试数据迁移前后数量一致；备份存在，但恢复和切回路径仍未演练。"
      },
      {
        "id": "u7",
        "role": "user",
        "content": "收到，今天先保留测试环境结果，不操作生产。"
      },
      {
        "id": "a7",
        "role": "assistant",
        "content": "已整理测试报告，没有执行生产切换。"
      }
    ],
    "expected": {
      "must_find": [
        "简短采纳不是用户理解迁移细节的证明。AI方案和后续报告中的恢复验证缺口与不丢预约的目标相关。",
        "可提出用备份恢复并核对内容、演练切回路径的新增检查，解释备份存在不等于可恢复。",
        "保留用户限制范围与不操作生产的有效判断。"
      ],
      "must_avoid": [
        "认定用户未考虑回退或造成数据丢失。",
        "把测试环境完成报告写成生产已切换或独立验证。"
      ]
    }
  },
